---
import Base from '../../layouts/Base.astro';

const title = 'News | Fristen, Hinweise & Updates | Steuerberatung Oettinger (Haan)';
const description = 'Kompakte Updates zu Fristen, Änderungen und typischen Praxisfragen – verständlich zusammengefasst und bei Bedarf im Gespräch eingeordnet.';
---

<Base title={title} description={description} noindex={true}>
<!-- SEO: News/Blog are placeholders until real content exists -->
        <section class="subhero">
          <div class="container">
            <div class="eyebrow">Aktuelles</div>
            <h1 class="section-title">News</h1>
            <p class="section-copy">Kompakte Hinweise, Fristen und Updates – so aufbereitet, dass Mandanten schnell verstehen, was relevant ist.</p>
          </div>
        </section>

        <section class="section">
          <div class="container">
            <div class="eyebrow">Neu</div>
            <h2 class="section-title section-title--sub">Aktuelle Hinweise</h2>
            <p class="section-copy">Ein paar typische Themen aus der Praxis. Wenn Sie dazu Fragen haben: melden Sie sich kurz – wir ordnen es in Ihre Situation ein.</p>

            <div class="grid-3 mt-4">
              <article class="card soft">
                <div class="card-kicker">Frist · 13.07.2026</div>
                <h3>Umsatzsteuer-Voranmeldung: Was Mandanten häufig übersehen.</h3>
                <p>Klarer Überblick: welche Unterlagen wirklich nötig sind – und wie Sie Rückfragen vermeiden, ohne mehr Arbeit zu haben.</p>
                <div class="tags"><span>UStVA</span><span>Organisation</span></div>
                <div class="mt-2"><a href="/kontakt/" class="button-secondary">Kurz klären</a></div>
              </article>

              <article class="card soft">
                <div class="card-kicker">Hinweis · 04.07.2026</div>
                <h3>E-Rechnung im Alltag: Welche Prozesse jetzt sinnvoll sind.</h3>
                <p>Von Eingang bis Archiv: Wir zeigen, wie Rechnungen digital sauber laufen – ohne unnötige Tool-Komplexität.</p>
                <div class="tags"><span>E-Rechnung</span><span>Workflow</span></div>
                <div class="mt-2"><a href="/leistungen/vermoegensaufbau/" class="button-secondary">Zur Seite</a></div>
              </article>

              <article class="card soft">
                <div class="card-kicker">Praxis · 26.06.2026</div>
                <h3>Belegfluss im Unternehmen: 5 Regeln, die sofort entlasten.</h3>
                <p>Weniger Nachfragen, weniger Sucherei: so bauen Sie einen Belegprozess, der im Team wirklich funktioniert.</p>
                <div class="tags"><span>Belege</span><span>Team</span></div>
                <div class="mt-2"><a href="/kontakt/" class="button-secondary">Ablauf abstimmen</a></div>
              </article>

              <article class="card soft">
                <div class="card-kicker">Kurzinfo · 12.06.2026</div>
                <h3>Geschäftsführung &amp; Privat: So trennen Sie sauber – ohne Extraaufwand.</h3>
                <p>Pragmatische Leitplanken, damit private und betriebliche Themen nicht in der Buchhaltung kollidieren.</p>
                <div class="tags"><span>Struktur</span><span>Risikoblick</span></div>
                <div class="mt-2"><a href="/leistungen/unternehmer/" class="button-secondary">Unternehmer-Fokus</a></div>
              </article>

              <article class="card soft">
                <div class="card-kicker">Hinweis · 02.06.2026</div>
                <h3>Handwerk &amp; Bau: Warum A’Conto die Auswertung „verzerren“ kann.</h3>
                <p>Wenn Gewinn „weg“ aussieht: Wir erklären kurz, was dahinter steckt – und wie man Auswertungen wieder steuerungsfähig macht.</p>
                <div class="tags"><span>A’Conto</span><span>BWA</span></div>
                <div class="mt-2"><a href="/branchen/handwerk-bau/" class="button-secondary">Zum Thema</a></div>
              </article>

              <article class="card soft">
                <div class="card-kicker">Praxis · 15.05.2026</div>
                <h3>E-Commerce: Payments, Fees &amp; Auszahlungen – typische Stolperstellen.</h3>
                <p>Wie Zahlungen, Gebühren und Auszahlungen sauber zusammengeführt werden – damit Buchhaltung und Controlling wieder stimmen.</p>
                <div class="tags"><span>Payments</span><span>Schnittstellen</span></div>
                <div class="mt-2"><a href="/branchen/e-commerce/" class="button-secondary">Mehr erfahren</a></div>
              </article>
            </div>
          </div>
        </section>
</Base>
