---
import Base from '../layouts/Base.astro';

const title = 'Impressum | Anbieterkennzeichnung | Steuerberatung Oettinger (Haan)';
const description = 'Impressum / Anbieterkennzeichnung mit Kontaktdaten, Aufsichtsbehörde, Berufshaftpflicht, Berufsordnung sowie Haftungs- und Urheberrechtshinweisen.';
---

<Base title={title} description={description} noindex={false}>
<section class="subhero"><div class="container"><div class="eyebrow">Impressum</div><h1 class="section-title">Impressum gemäß § 5 TMG</h1><p class="section-copy">Pflichtangaben nach § 5 TMG sowie Hinweise zu Haftung und Urheberrecht. Wenn Sie Fragen zu den Angaben haben: schreiben Sie uns kurz an <a href="mailto:info@stbin-oettinger.de">info@stbin-oettinger.de</a>.</p></div></section>
        <section class="section">
          <div class="container">
            <article class="legal-card" id="legal-impressum-top">
              <nav class="legal-toc" aria-label="Inhaltsverzeichnis Impressum">
                <div class="legal-toc-title">
                  <strong>Inhaltsverzeichnis</strong>
                  <a href="#legal-impressum-a1" data-legal-jump="">Zum ersten Abschnitt</a>
                </div>
                <ul>
                  <li><a href="#legal-impressum-a1" data-legal-jump="">Kontakt</a></li>
                  <li><a href="#legal-impressum-a2" data-legal-jump="">Umsatzsteuer-ID</a></li>
                  <li><a href="#legal-impressum-a3" data-legal-jump="">Aufsichtsbehörde</a></li>
                  <li><a href="#legal-impressum-a4" data-legal-jump="">Berufshaftpflichtversicherung</a></li>
                  <li><a href="#legal-impressum-a5" data-legal-jump="">Gebühren- und Berufsordnungen</a></li>
                  <li><a href="#legal-impressum-a6" data-legal-jump="">Haftung für Inhalte</a></li>
                  <li><a href="#legal-impressum-a7" data-legal-jump="">Haftung für Links</a></li>
                  <li><a href="#legal-impressum-a8" data-legal-jump="">Urheberrecht</a></li>
                </ul>
              </nav>

              <div class="legal-accordion">
                <details class="legal-item" id="legal-impressum-a1" open="">
                  <summary>
                    <span class="legal-sum"><span class="kicker">Abschnitt</span><span class="title">Kontakt</span></span>
                    <svg class="legal-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg>
                  </summary>
                  <div class="legal-body">
                    <p>Evelyn Krämer<br>Steuerberaterin<br>Zeppelinstraße 1<br>42781 Haan</p>
                    <p>Telefon: +49 (0) 2129 - 566 22 - 0<br>Telefax: +49 (0) 2129 - 566 22 - 10<br>E-Mail: info@stbin-oettinger.de</p>
                    <a class="legal-jump" href="#legal-impressum-top" data-legal-jump="">Zurück zum Inhaltsverzeichnis</a>
                  </div>
                </details>

                <details class="legal-item" id="legal-impressum-a2">
                  <summary>
                    <span class="legal-sum"><span class="kicker">Abschnitt</span><span class="title">Umsatzsteuer-ID</span></span>
                    <svg class="legal-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg>
                  </summary>
                  <div class="legal-body">
                    <p>Umsatzsteuer-Identifikationsnummer gemäß § 27 a Umsatzsteuergesetz: DE 256657841</p>
                    <a class="legal-jump" href="#legal-impressum-top" data-legal-jump="">Zurück zum Inhaltsverzeichnis</a>
                  </div>
                </details>

                <details class="legal-item" id="legal-impressum-a3">
                  <summary>
                    <span class="legal-sum"><span class="kicker">Abschnitt</span><span class="title">Aufsichtsbehörde</span></span>
                    <svg class="legal-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg>
                  </summary>
                  <div class="legal-body">
                    <p>Steuerberaterkammer Düsseldorf<br>Berufsbezeichnung: Steuerberaterin<br>Zuständige Kammer: Düsseldorf<br>Verliehen durch: Deutschland</p>
                    <p>Regelungen einsehbar unter: https://www.stbk-duesseldorf.de/kontakt/</p>
                    <a class="legal-jump" href="#legal-impressum-top" data-legal-jump="">Zurück zum Inhaltsverzeichnis</a>
                  </div>
                </details>

                <details class="legal-item" id="legal-impressum-a4">
                  <summary>
                    <span class="legal-sum"><span class="kicker">Abschnitt</span><h2 class="title">Angaben zur Berufshaftpflichtversicherung</h2></span>
                    <svg class="legal-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg>
                  </summary>
                  <div class="legal-body">
                    <h3>Name und Sitz des Versicherers</h3>
                    <p>Allianz Versicherung AG<br>Königinstraße 28<br>80802 München</p>
                    <h3>Geltungsraum der Versicherung</h3>
                    <p>Deutschland</p>
                    <a class="legal-jump" href="#legal-impressum-top" data-legal-jump="">Zurück zum Inhaltsverzeichnis</a>
                  </div>
                </details>

                <details class="legal-item" id="legal-impressum-a5">
                  <summary>
                    <span class="legal-sum"><span class="kicker">Abschnitt</span><span class="title">Es gelten folgende Gebühren- und Berufsordnungen</span></span>
                    <svg class="legal-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg>
                  </summary>
                  <div class="legal-body">
                    <ul>
                      <li>StBG – Steuerberatungsgesetz</li>
                      <li>StBGebV – Steuerberatergebührenverordnung</li>
                      <li>BOSt – Berufsordnung der Steuerberater</li>
                      <li>DVStB – Verordnung zur Durchführung der Vorschriften über Steuerberater, Steuerbevollmächtigte und Steuerberatungsgesellschaften</li>
                    </ul>
                    <p>Diese Gesetzestexte können im Internet unter www.dstv.de recherchiert werden.</p>
                    <a class="legal-jump" href="#legal-impressum-top" data-legal-jump="">Zurück zum Inhaltsverzeichnis</a>
                  </div>
                </details>

                <details class="legal-item" id="legal-impressum-a6">
                  <summary>
                    <span class="legal-sum"><span class="kicker">Abschnitt</span><span class="title">Haftung für Inhalte</span></span>
                    <svg class="legal-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg>
                  </summary>
                  <div class="legal-body">
                    <p>Als Diensteanbieter sind wir gemäß § 7 Abs. 1 TMG für eigene Inhalte auf diesen Seiten nach den allgemeinen Gesetzen verantwortlich. Nach §§ 8 bis 10 TMG sind wir als Diensteanbieter jedoch nicht verpflichtet, übermittelte oder gespeicherte fremde Informationen zu überwachen oder nach Umständen zu forschen, die auf eine rechtswidrige Tätigkeit hinweisen.</p>
                    <a class="legal-jump" href="#legal-impressum-top" data-legal-jump="">Zurück zum Inhaltsverzeichnis</a>
                  </div>
                </details>

                <details class="legal-item" id="legal-impressum-a7">
                  <summary>
                    <span class="legal-sum"><span class="kicker">Abschnitt</span><span class="title">Haftung für Links</span></span>
                    <svg class="legal-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg>
                  </summary>
                  <div class="legal-body">
                    <p>Unser Angebot enthält Links zu externen Webseiten Dritter, auf deren Inhalte wir keinen Einfluss haben. Deshalb können wir für diese fremden Inhalte keine Gewähr übernehmen. Für die Inhalte verlinkter Seiten ist stets der jeweilige Anbieter oder Betreiber verantwortlich.</p>
                    <a class="legal-jump" href="#legal-impressum-top" data-legal-jump="">Zurück zum Inhaltsverzeichnis</a>
                  </div>
                </details>

                <details class="legal-item" id="legal-impressum-a8">
                  <summary>
                    <span class="legal-sum"><span class="kicker">Abschnitt</span><span class="title">Urheberrecht</span></span>
                    <svg class="legal-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg>
                  </summary>
                  <div class="legal-body">
                    <p>Die durch die Seitenbetreiber erstellten Inhalte und Werke auf diesen Seiten unterliegen dem deutschen Urheberrecht. Downloads und Kopien dieser Seite sind nur für den privaten, nicht kommerziellen Gebrauch gestattet.</p>
                    <a class="legal-jump" href="#legal-impressum-top" data-legal-jump="">Zurück zum Inhaltsverzeichnis</a>
                  </div>
                </details>
              </div>
            </article>
          </div>
        </section>
</Base>
