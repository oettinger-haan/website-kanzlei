---
import Base from '../layouts/Base.astro';

const title = 'Newsletter & Rückfragen | Steuerberatung Oettinger';
const description = 'Newsletter abonnieren oder eine Frage zu einem Steuernews-Thema stellen – direkt an Ihre Ansprechpartnerin oder Ihren Ansprechpartner bei Steuerberatung Oettinger.';
---

<Base title={title} description={description} noindex={false}>
        <section class="subhero">
          <div class="container">
            <div class="eyebrow">Dialog</div>
            <h1 class="section-title">Newsletter &amp; Rückfragen</h1>
            <p class="section-copy">Abonnieren Sie unseren Newsletter oder stellen Sie direkt eine Frage zu einem Thema aus unseren Steuernews – wir melden uns persönlich zurück.</p>
          </div>
        </section>

        <section class="section">
          <div class="container">
            <!-- WIADOK Form-Builder-Widget (Newsletter-Anmeldung + Rueckfrageformular
                 in einem Baustein, gesteuert ueber ?form=... in der URL - Default
                 ist "newsletter", siehe _dataDefaultFormId). Wie beim Steuernews-
                 Widget: inert im <template>, erst nach Zustimmung aktiv. -->
            <div class="embed-consent embed-consent--fluid" data-embed="wiadok-dialog" aria-label="Newsletter- und Rückfrageformular von WIADOK">
              <div class="embed-consent-inner">
                <span class="embed-consent-badge">Externer Inhalt &middot; WIADOK</span>
                <p class="copy-tight">Wird nach Ihrer Zustimmung im Banner unten angezeigt.</p>
              </div>
              <template>
                <wiadok-frame api-config="{&quot;_confRequestUrl&quot;:&quot;https%3A%2F%2Fwww.steuerberaterin-haan.de%2Fdialog%2F&quot;,&quot;_confErrorFlag&quot;:0,&quot;_confClientCssUrl&quot;:&quot;https://publisher-api.wiadok.de/apiSources/82389227/view.css&quot;,&quot;_confTemplateId&quot;:82389227}" api-client-data="{&quot;_dataApiType&quot;:&quot;form-builder&quot;,&quot;_dataDefaultFormId&quot;:&quot;newsletter&quot;,&quot;_dataClientColor&quot;:&quot;#4d179a&quot;,&quot;_formBuilderData&quot;:[{&quot;id&quot;:&quot;newsletter&quot;,&quot;type&quot;:&quot;optin&quot;,&quot;submitConfig&quot;:[{&quot;sendId&quot;:&quot;subscription_send&quot;,&quot;from&quot;:&quot;info@mandanten.email&quot;,&quot;subject&quot;:&quot;Bestätigen Sie jetzt Ihr Abonnement für unseren Newsletter&quot;,&quot;to&quot;:&quot;#mailadress#&quot;,&quot;templateId&quot;:82389198}],&quot;successId&quot;:&quot;optin_success_page&quot;,&quot;submit&quot;:{&quot;label&quot;:&quot;Jetzt abonnieren&quot;,&quot;class&quot;:&quot;&quot;},&quot;fields&quot;:[]},{&quot;id&quot;:&quot;confirm&quot;,&quot;type&quot;:&quot;confirm&quot;,&quot;submitConfig&quot;:[{&quot;sendId&quot;:&quot;subscription_success_client&quot;,&quot;from&quot;:&quot;info@mandanten.email&quot;,&quot;subject&quot;:&quot;Ab jetzt erhalten Sie unseren Newsletter&quot;,&quot;to&quot;:&quot;#email#&quot;,&quot;templateId&quot;:82389198},{&quot;sendId&quot;:&quot;subscription_success_employee&quot;,&quot;from&quot;:&quot;info@mandanten.email&quot;,&quot;fromName&quot;:&quot;WIADOK Kundenservice&quot;,&quot;subject&quot;:&quot;Benachrichtigung über Registrierung zum Newsletter&quot;,&quot;to&quot;:&quot;sascha.witte@wiadok.de&quot;,&quot;replyTo&quot;:&quot;info@wiadok.de&quot;,&quot;templateId&quot;:false}],&quot;successId&quot;:&quot;confirm_success_page&quot;,&quot;fields&quot;:[]},{&quot;id&quot;:&quot;kontool_order&quot;,&quot;type&quot;:&quot;single&quot;,&quot;submitConfig&quot;:[{&quot;sendId&quot;:&quot;order_office_notification&quot;,&quot;to&quot;:&quot;kanzlei@xyz.de&quot;,&quot;from&quot;:&quot;info@mandanten.email&quot;,&quot;fromName&quot;:&quot;WIADOK Kundenservice&quot;,&quot;subject&quot;:&quot;kontool Zugang angefordert!&quot;,&quot;replyTo&quot;:&quot;info@wiadok.de&quot;,&quot;templateId&quot;:789123},{&quot;sendId&quot;:&quot;order_client_thankyou&quot;,&quot;to&quot;:&quot;#mailadress#&quot;,&quot;from&quot;:&quot;info@mandanten.email&quot;,&quot;fromName&quot;:&quot;Steuerberatung Oettinger&quot;,&quot;subject&quot;:&quot;Zugang wird in kürze Angelegt und bereitgestellt&quot;,&quot;replyTo&quot;:&quot;info@wiadok.de&quot;,&quot;templateId&quot;:82389198}],&quot;successId&quot;:&quot;order_success_page&quot;,&quot;formValues&quot;:{},&quot;submit&quot;:{&quot;label&quot;:&quot;Zugang jetzt anfordern&quot;,&quot;class&quot;:&quot;&quot;},&quot;viewTemplates&quot;:{&quot;preTemplateFormId&quot;:false,&quot;postTemplateFormId&quot;:&quot;order_checkout_banner&quot;},&quot;fields&quot;:[{&quot;label&quot;:&quot;Ihr Vor- und Nachname *&quot;,&quot;placeholder&quot;:&quot;&quot;,&quot;name&quot;:&quot;fullname&quot;,&quot;as&quot;:&quot;input&quot;,&quot;type&quot;:&quot;text&quot;,&quot;inputClass&quot;:&quot;&quot;,&quot;rules&quot;:[{&quot;datatype&quot;:&quot;string&quot;},{&quot;datatype&quot;:&quot;required&quot;,&quot;message&quot;:&quot;Bitte geben Sie Ihren Namen ein&quot;}]},{&quot;label&quot;:&quot;Ihre E-Mail-Adresse *&quot;,&quot;placeholder&quot;:&quot;&quot;,&quot;name&quot;:&quot;mailadress&quot;,&quot;type&quot;:&quot;email&quot;,&quot;inputClass&quot;:&quot;&quot;,&quot;as&quot;:&quot;input&quot;,&quot;rules&quot;:[{&quot;datatype&quot;:&quot;string&quot;},{&quot;datatype&quot;:&quot;email&quot;,&quot;message&quot;:&quot;Bitte geben Sie eine gültige E-Mail-Adresse ein&quot;},{&quot;datatype&quot;:&quot;required&quot;,&quot;message&quot;:&quot;Bitte geben Sie Ihre E-Mail-Adresse ein&quot;}]},{&quot;label&quot;:&quot;Mandanten angaben (durch Komma trennen) *&quot;,&quot;placeholder&quot;:&quot;&quot;,&quot;name&quot;:&quot;companyname&quot;,&quot;as&quot;:&quot;input&quot;,&quot;type&quot;:&quot;text&quot;,&quot;inputClass&quot;:&quot;&quot;,&quot;rules&quot;:[{&quot;datatype&quot;:&quot;string&quot;},{&quot;datatype&quot;:&quot;required&quot;,&quot;message&quot;:&quot;Bitte geben Sie den Namen Ihres Unternehmen ein&quot;}]},{&quot;label&quot;:&quot;Mit der Nutzung dieses Formulars erklären Sie sich mit der Speicherung und Verarbeitung Ihrer Daten durch diese Website einverstanden. Weitere Hinweise erhalten Sie unter: &lt;a href=\&quot;#\&quot; target=\&quot;_blank\&quot; title=\&quot;\&quot;&gt;Datenschutzerklärung&lt;/a&gt;&quot;,&quot;name&quot;:&quot;gdprcheck&quot;,&quot;as&quot;:&quot;input&quot;,&quot;type&quot;:&quot;checkbox&quot;,&quot;value&quot;:false,&quot;inputClass&quot;:&quot;fb-form-check&quot;,&quot;rules&quot;:[{&quot;datatype&quot;:&quot;boolean&quot;},{&quot;datatype&quot;:&quot;required&quot;,&quot;message&quot;:&quot;Bitte stimmen Sie unseren Bestimmung zu&quot;}]}]},{&quot;id&quot;:&quot;frage_stellen&quot;,&quot;type&quot;:&quot;single&quot;,&quot;submitConfig&quot;:[{&quot;sendId&quot;:&quot;ask_contact_notification&quot;,&quot;to&quot;:&quot;#employeemail#&quot;,&quot;from&quot;:&quot;info@mandanten.email&quot;,&quot;fromName&quot;:&quot;WIADOK Kundenservice&quot;,&quot;subject&quot;:&quot;Benachrichtigung über eine Anfrage zum Thema&quot;,&quot;replyTo&quot;:&quot;info@wiadok.de&quot;,&quot;templateId&quot;:false}],&quot;successId&quot;:&quot;ask_success_page&quot;,&quot;formValues&quot;:{},&quot;additionalValues&quot;:{&quot;taxnewsClientUrl&quot;:&quot;https://www.steuerberaterin-haan.de/news/?article=&quot;},&quot;submit&quot;:{&quot;label&quot;:&quot;Frage absenden&quot;,&quot;class&quot;:&quot;&quot;},&quot;fields&quot;:[{&quot;label&quot;:&quot;Ihre E-Mail-Adresse *&quot;,&quot;placeholder&quot;:&quot;&quot;,&quot;name&quot;:&quot;mailadress&quot;,&quot;type&quot;:&quot;email&quot;,&quot;inputClass&quot;:&quot;&quot;,&quot;as&quot;:&quot;input&quot;,&quot;rules&quot;:[{&quot;datatype&quot;:&quot;string&quot;},{&quot;datatype&quot;:&quot;email&quot;,&quot;message&quot;:&quot;Bitte geben Sie eine gültige E-Mail-Adresse ein&quot;},{&quot;datatype&quot;:&quot;required&quot;,&quot;message&quot;:&quot;Bitte geben Sie Ihre E-Mail-Adresse ein&quot;}]},{&quot;label&quot;:&quot;Name (optional)&quot;,&quot;placeholder&quot;:&quot;&quot;,&quot;name&quot;:&quot;fullname&quot;,&quot;as&quot;:&quot;input&quot;,&quot;type&quot;:&quot;text&quot;,&quot;inputClass&quot;:&quot;&quot;},{&quot;label&quot;:&quot;Ihre Frage *&quot;,&quot;placeholder&quot;:&quot;&quot;,&quot;name&quot;:&quot;message&quot;,&quot;as&quot;:&quot;textarea&quot;,&quot;type&quot;:&quot;text&quot;,&quot;inputClass&quot;:&quot;&quot;,&quot;rules&quot;:[{&quot;datatype&quot;:&quot;string&quot;},{&quot;datatype&quot;:&quot;required&quot;,&quot;message&quot;:&quot;Bitte geben Sie IhreFrage ein&quot;}]},{&quot;label&quot;:&quot;Erforderlich: Ich bestätige hiermit, dass ich die &lt;a href=\&quot;https://www.steuerberaterin-haan.de/datenschutz/\&quot; target=\&quot;_blank\&quot; title=\&quot;Unsere Datenschutzbestimmungen\&quot;&gt;Datenschutzbestimmungen&lt;/a&gt; zur Kenntnis genommen habe.&quot;,&quot;name&quot;:&quot;gdprcheck&quot;,&quot;as&quot;:&quot;input&quot;,&quot;type&quot;:&quot;checkbox&quot;,&quot;value&quot;:false,&quot;inputClass&quot;:&quot;fb-form-check&quot;,&quot;rules&quot;:[{&quot;datatype&quot;:&quot;boolean&quot;},{&quot;datatype&quot;:&quot;required&quot;,&quot;message&quot;:&quot;Bitte stimmen Sie unseren Bestimmung zu&quot;}]}]}]}"></wiadok-frame>
                <script is:inline>
                  var _wiadok = _wiadok || [];
                  _wiadok['_baseUrl'] = 'publisher-api.wiadok.de';
                  _wiadok['_requestUrl'] = encodeURIComponent(document.location.href);
                  (function () {
                    var wiadok = document.createElement('script');
                    wiadok.type = 'text/javascript';
                    wiadok.src = '//' + _wiadok['_baseUrl'] + '/custom/themes/api-v2.0.2/api.min.js';
                    document.getElementsByTagName('head')[0].appendChild(wiadok);
                  })();
                </script>
              </template>
            </div>
          </div>
        </section>
</Base>
